// 文件：prisma/schema.prisma
// 描述：Laity 项目档案库数据库模型（User / Project / Log，V2.0 多租户）
// 作者：张磊
// 创建日期：2026-10-30
// 修改记录：
// - 2026-10-30: 初始创建，按 SPEC.md 建表草案定义 Project 与 Log
// - 2026-11-09: V2.0 Phase 1：新增 User 模型；Project/Log 加 userId（onDelete: Cascade，
//               删除用户即连带走其档案，与 C5 不级联的 Log→Project 关系是两件事）；
//               slug 由全局唯一改为租户内唯一 @@unique([userId, slug])；
//               userId 本阶段保持可空，NOT NULL 锁与索引收紧留 Step 4（含回填脚本与校验）；
//               存量数据回填为独立脚本 prisma/backfill-zhanglei.ts（M1 保持可空，应用不中断）
// - 2026-11-09: V2.0 Step 4-A：User 加 githubId（nullable + 唯一），GitHub OAuth 认领/建号用；
//               迁移由本人本地执行 npx prisma migrate dev --name add_github_id
// - 2026-11-09: V2.0 Step 4-B：isAdmin 字段注释改记退役事实（仅注释，不改字段、不生成迁移）
// - 2026-11-10: V2.0 Step 5 Commit 1：User 加 githubAccessToken（AES-256-GCM 密文，可空）；
//               Log 加 sourceCommitSha + @@unique([userId, sourceCommitSha])（同步草稿幂等去重锚点）；
//               迁移由本人本地执行 npx prisma migrate dev --name step5_sync_foundation
// - 2026-11-10: V2.0 Step 6 Commit 3：Log 加 isAiAssisted（AI 辅助生成标记，默认 false）；
//               详情页据此在正文末尾打「[ AI 辅助生成 · 作者审校 ]」标签；
//               迁移由本人本地执行 npx prisma migrate dev --name add_is_ai_assisted
// - 2026-11-13: 本轮升级（O4）：补两条读路径索引——@@index([isPublished, beforeDate]) 服务全站大厅
//               （原先只有以 userId 开头的复合索引，全局 where: {isPublished} 用不上）；
//               @@index([tags], type: Gin) 服务标签筛选、标签聚合页前置判定与搜索的 tags 分支。
//               迁移：npx prisma migrate dev --name hall_read_indexes（只加索引，不改列）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  handle    String   @unique
  // GitHub OAuth（V2.0 Step 4-A）：authorize 凭它认领旧账号或建新用户；可空兼容存量行，回填由登录链路自愈
  githubId  String?  @unique
  // GitHub access_token 的 AES-256-GCM 密文（V2.0 Step 5）：只在服务端由 token-crypto.ts 解密使用，
  // 不进 JWT、不进 session、不打日志；可空——存量会话需退出重登一次才补上
  githubAccessToken String?
  name      String?
  // V1 遗留布尔位：Step 4-B 起会话与准入都不再读它（判据改 userId），字段保留不迁移，避免动库
  isAdmin   Boolean  @default(false)
  projects  Project[]
  logs      Log[]
  series    Series[]
  previewTokens PreviewToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String
  name      String
  kind      String // product | tool | site
  status    String // WIP | LIVE | ARCHIVED
  summary   String?
  repoUrl   String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())
  logs      Log[]

  @@unique([userId, slug])
}

model Log {
  id            String   @id @default(cuid())
  title         String
  slug          String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  tags          String[]
  // 系列名（2026-11-16 V3.1 G2）：自由文本；V4 P2 起与 Series 实体双写，
  // 保留字符串用于旧 URL/展示兼容，读取端优先用 seriesId
  series        String?
  // 系列实体（V4 P2）：可空；删除系列时 SetNull，不级联删日志
  seriesId      String?
  seriesRef     Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder   Int      @default(0)
  beforeContent String
  afterContent  String?
  beforeDate    DateTime
  afterDate     DateTime?
  isPublished   Boolean  @default(false)
  lessonLearned String?
  publishedAt   DateTime?
  contentHash   String?
  // 同步草稿的来源 commit sha（V2.0 Step 5）：幂等去重锚点，重复点同步不产重复行；
  // 手写日志为 null，Postgres 唯一索引视多个 null 互不相同，不影响存量
  sourceCommitSha String?
  // AI 辅助生成标记（V2.0 Step 6）：编辑器点过 [ AI 帮我写 ] 且正文来自模型输出时置 true；
  // 详情页据此在正文末尾打「[ AI 辅助生成 · 作者审校 ]」，提醒读者内容经过作者审校
  isAiAssisted Boolean @default(false)
  // 公开预览链接（V3.1 G7）：一次性生成、24h 过期、存哈希；日志删除时级联清掉
  previewTokens PreviewToken[]
  // 修订历史（V4 P3）：每次发布前把旧版本追加一条，最多保留 20 条
  revisions     Revision[]
  // 上次发布快照（V3.1 G8）：发布时写入当时的标题/正文/标签/系列/摘要与发布时间；
  // 之后编辑退回草稿时，拿它对比“上次对外长什么样”，不在库外存历史
  lastPublishedSnapshot Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 复合唯一：租户内 slug 唯一（V2.0 裁定 ②）；V1 的 /logs/[slug] 全局路由由 Step 3 搬进 /u/[handle]/...
  @@unique([userId, slug])
  // 同一租户下同一来源 commit 只产一条草稿（Step 5 决策点 D-3）
  @@unique([userId, sourceCommitSha])
  // 为租户视图查询（用户 + 已发布 + 时间）先建复合索引
  @@index([userId, isPublished, beforeDate])
  // 系列页与详情页进度：按作者 + 已发布 + 系列名过滤
  @@index([userId, isPublished, series])
  // 全站大厅：where isPublished + orderBy beforeDate desc（不带 userId），上面的复合索引用不上
  @@index([isPublished, beforeDate])
  // 标签数组：筛选（has/hasSome）、标签聚合页前置判定与搜索的 tags 分支都走它
  @@index([tags], type: Gin)
  @@index([projectId])
  @@index([seriesId])
}

// 系列实体（V4 P2）：同一作者下 slug 唯一；name 为展示名，slug 为稳定内部键。
// 兼容期 Log.series 字符串继续保留用于旧 URL/展示；新写入同时落 seriesId。
model Series {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      Log[]

  @@unique([userId, slug])
  @@index([userId])
}

// 公开预览链接（V3.1 G7）：只存 token 的 SHA-256 哈希，不存明文；24h 过期；
// 一条日志可有多个有效链接（每次生成一条，便于分别撤销/过期），日志删除级联清理
model PreviewToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  logId     String
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([logId])
  @@index([expiresAt])
}

// 修订历史（V4 P3）：发布时把“上一版”追加进来，当前版本始终在 Log 行上。
// 只存发布过的版本（isPublished=true 且有 contentHash/publishedAt）；每篇最多 20 条，超出同事务删最旧。
model Revision {
  id            String   @id @default(cuid())
  logId         String
  log           Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  title         String
  beforeContent String
  afterContent  String?
  tags          String[]
  contentHash   String
  publishedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([logId, createdAt])
}

// 审计（V4 P3）：只记"谁在何时对哪条对象做了什么"，不存正文、token 或密钥。
// 写入是尽力而为：动作成功后记录，失败只打日志，不阻塞主动作。
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, action])
}
