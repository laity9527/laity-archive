// 文件：prisma/schema.prisma
// 描述：Laity 项目档案库数据库模型（User / Project / Log，V2.0 多租户）
// 作者：张磊
// 创建日期：2026-10-30
// 修改记录：
// - 2026-10-30: 初始创建，按 SPEC.md 建表草案定义 Project 与 Log
// - 2026-11-09: V2.0 Phase 1：新增 User 模型；Project/Log 加 userId（onDelete: Cascade，
//               删除用户即连带走其档案，与 C5 不级联的 Log→Project 关系是两件事）；
//               slug 由全局唯一改为租户内唯一 @@unique([userId, slug])；
//               userId 本阶段保持可空，NOT NULL 锁与索引收紧留 Step 4（含回填脚本与校验）；
//               存量数据回填为独立脚本 prisma/backfill-zhanglei.ts（M1 保持可空，应用不中断）
// - 2026-11-09: V2.0 Step 4-A：User 加 githubId（nullable + 唯一），GitHub OAuth 认领/建号用；
//               迁移由本人本地执行 npx prisma migrate dev --name add_github_id
// - 2026-11-09: V2.0 Step 4-B：isAdmin 字段注释改记退役事实（仅注释，不改字段、不生成迁移）
// - 2026-11-10: V2.0 Step 5 Commit 1：User 加 githubAccessToken（AES-256-GCM 密文，可空）；
//               Log 加 sourceCommitSha + @@unique([userId, sourceCommitSha])（同步草稿幂等去重锚点）；
//               迁移由本人本地执行 npx prisma migrate dev --name step5_sync_foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  handle    String   @unique
  // GitHub OAuth（V2.0 Step 4-A）：authorize 凭它认领旧账号或建新用户；可空兼容存量行，回填由登录链路自愈
  githubId  String?  @unique
  // GitHub access_token 的 AES-256-GCM 密文（V2.0 Step 5）：只在服务端由 token-crypto.ts 解密使用，
  // 不进 JWT、不进 session、不打日志；可空——存量会话需退出重登一次才补上
  githubAccessToken String?
  name      String?
  // V1 遗留布尔位：Step 4-B 起会话与准入都不再读它（判据改 userId），字段保留不迁移，避免动库
  isAdmin   Boolean  @default(false)
  projects  Project[]
  logs      Log[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String
  name      String
  kind      String // product | tool | site
  status    String // WIP | LIVE | ARCHIVED
  summary   String?
  repoUrl   String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())
  logs      Log[]

  @@unique([userId, slug])
}

model Log {
  id            String   @id @default(cuid())
  title         String
  slug          String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  tags          String[]
  beforeContent String
  afterContent  String?
  beforeDate    DateTime
  afterDate     DateTime?
  isPublished   Boolean  @default(false)
  lessonLearned String?
  publishedAt   DateTime?
  contentHash   String?
  // 同步草稿的来源 commit sha（V2.0 Step 5）：幂等去重锚点，重复点同步不产重复行；
  // 手写日志为 null，Postgres 唯一索引视多个 null 互不相同，不影响存量
  sourceCommitSha String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 复合唯一：租户内 slug 唯一（V2.0 裁定 ②）；V1 的 /logs/[slug] 全局路由由 Step 3 搬进 /u/[handle]/...
  @@unique([userId, slug])
  // 同一租户下同一来源 commit 只产一条草稿（Step 5 决策点 D-3）
  @@unique([userId, sourceCommitSha])
  // 为租户视图查询（用户 + 已发布 + 时间）先建复合索引
  @@index([userId, isPublished, beforeDate])
  @@index([projectId])
}
