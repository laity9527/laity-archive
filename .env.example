# 数据库（本地开发容器；弱口令仅限本地，上线前必须更换）
DATABASE_URL="postgresql://root:root@localhost:5432/laity?schema=public"

# GitHub OAuth App（本机在 GitHub → Settings → Developer settings → OAuth Apps 创建）
# 回调地址填 http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# NextAuth 会话签名密钥：本地用 `openssl rand -base64 32` 生成，生产必须另换
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 白名单：允许登录的 GitHub 账号 ID（数字 ID，不是用户名），多个用英文逗号分隔
ALLOWED_GITHUB_IDS=""
