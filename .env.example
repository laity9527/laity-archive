# 数据库（本地开发容器；弱口令仅限本地，上线前必须更换）
DATABASE_URL="postgresql://root:root@localhost:5432/laity?schema=public"

# 后台登录口令（2026-11-04 起不再走 GitHub 登录）：本地自定一个，登录页 /login 只认它
ADMIN_PASSWORD=""

# NextAuth 会话签名密钥：本地用 `openssl rand -base64 32` 生成，生产必须另换
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 阿里云 OSS 图片上传（Phase 5b）
# Bucket 公共读、RAM 策略只给 oss:PutObject 且限定 laity-archive/logs/*
# 密钥只填在本地 .env 与服务器 .env.production，禁止写进仓库
OSS_REGION="oss-cn-beijing"
OSS_BUCKET="laity-archive"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""

# ICP 备案号（非密钥）：备案通过后填入，如"京ICP备xxxxxxxx号-1"；留空则页脚不显示该行
SITE_ICP=
# 公安联网备案号（ICP 备案后 30 日内办理）：留空则页脚不显示该行
SITE_POLICE_ICP=
# 对外联系与侵权投诉邮箱：留空则页脚不出"侵权投诉与联系"，禁止拿个人邮箱硬凑
SITE_CONTACT_EMAIL=
