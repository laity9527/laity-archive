# 文件：.env.production.example
# 描述：生产环境变量模板（docker-compose.prod.yml 用 --env-file .env.production 读取）；复制后填真实值，真实文件不入库
# 作者：张磊
# 创建日期：2026-10-30
# 修改记录：
# - 2026-10-30: 初始创建（Phase 6 环境准备）
# - 2026-11-02: 补 Phase 5b 的 OSS 四个变量（此前生产模板漏了整段，上传功能在生产必然起不来）
# - 2026-11-04: 按我点名"先取消 github 登录"：删 GITHUB_ID / GITHUB_SECRET / ALLOWED_GITHUB_IDS，改为 ADMIN_PASSWORD
# - 2026-11-09: V2.0 Step 4-A：换回 GitHub OAuth——ADMIN_PASSWORD 退役（代码已不读它），
#               GITHUB_ID / GITHUB_SECRET 回补；docker-compose.prod.yml 的口令 preflight 本轮未动，
#               上线前需自行同步（见当轮汇报）
# - 2026-11-09: V2.0 Step 4-B：compose 的 preflight/app 已同步透传 GitHub 两键（4-A 遗留收口）；
#               NEXTAUTH_URL 注释去掉口令口径；OSS 注释改记对象键前缀 logs/<userId>/（RAM 策略 logs/* 仍覆盖）
# - 2026-11-10: V2.0 Step 5 Commit 1：补 ENCRYPTION_KEY（GitHub token 落库加密，64 位 hex）；
#               compose 的 preflight/app 同步透传并硬卡形态

# 用法：cp .env.production.example .env.production，填完后
#   docker compose --env-file .env.production -f docker-compose.prod.yml build
#   docker compose --env-file .env.production -f docker-compose.prod.yml run --rm migrate
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d

# ---- 数据库 ----
# 上线门禁硬卡：不许用 root / root（开发容器那套只在本地）
POSTGRES_USER=laity_app
POSTGRES_PASSWORD=
POSTGRES_DB=laity

# ---- 应用与 NextAuth ----
# 正式域名，scheme 必须是 https：OAuth 回调与会话 Cookie 都走这条链路，http 等于把会话暴露在公网
NEXTAUTH_URL=https://laity.cn
# 生产单独生成，不与开发环境复用：openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- GitHub OAuth 登录 ----
# GitHub OAuth App 的 client id/secret；登录页 /login 只认这条通道
# 值不落仓库、不落对话，也不与本地开发环境复用
GITHUB_ID=
GITHUB_SECRET=

# ---- GitHub token 落库加密（V2.0 Step 5）----
# 64 位 hex（32 字节），AES-256-GCM；生产单独生成，不与本地 .env 复用
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# preflight 硬卡形态；缺失时登录认领直接失败。换钥后旧密文解不开，用户需退出重登
ENCRYPTION_KEY=

# ---- 阿里云 OSS 图片上传（Phase 5b）----
# Bucket 公共读；RAM 策略 LaityOssUploadPolicy 只给 oss:PutObject，且限定 acs:oss:*:*:laity-archive/logs/*
# 对象键前缀在 src/lib/object-key.ts 里生成为 logs/<userId>/，RAM 策略的 Resource（logs/*）仍覆盖，无需改策略
# 生产另建一把 AccessKey（不与本地 .env 复用）；本地那把曾在对话里明文出现，上线前先在 RAM 控制台轮换
# 外链域名由代码按 https://<bucket>.<region>.aliyuncs.com/<key> 拼，不读本文件里的自定义域名变量
OSS_REGION=oss-cn-beijing
OSS_BUCKET=laity-archive
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 这四个键由 docker-compose.prod.yml 的 app 服务透传进容器，缺失时 compose 在部署阶段就报错（I024 已修）

# ---- 合规位 ----
# ICP 备案号（非密钥）：由我本人在备案通过后填入；留空则前台页脚不渲染该行
SITE_ICP=
# 公安联网备案号：ICP 备案后 30 日内办理；留空则页脚不渲染该行
SITE_POLICE_ICP=
# 对外联系与侵权投诉邮箱：留空则页脚不出投诉入口
SITE_CONTACT_EMAIL=
