# 文件：.env.production.example
# 描述：生产环境变量模板（docker-compose.prod.yml 用 --env-file .env.production 读取）；复制后填真实值，真实文件不入库
# 作者：张磊
# 创建日期：2026-10-30
# 修改记录：
# - 2026-10-30: 初始创建（Phase 6 环境准备）
# - 2026-11-02: 补 Phase 5b 的 OSS 四个变量（此前生产模板漏了整段，上传功能在生产必然起不来）

# 用法：cp .env.production.example .env.production，填完后
#   docker compose --env-file .env.production -f docker-compose.prod.yml build
#   docker compose --env-file .env.production -f docker-compose.prod.yml run --rm migrate
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d

# ---- 数据库 ----
# 上线门禁硬卡：不许用 root / root（开发容器那套只在本地）
POSTGRES_USER=laity_app
POSTGRES_PASSWORD=
POSTGRES_DB=laity

# ---- 应用与 NextAuth ----
# 正式域名，scheme 必须是 https，否则 GitHub 回调对不上
NEXTAUTH_URL=https://laity.example.com
# 生产单独生成，不与开发环境复用：openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- GitHub OAuth（生产专用 App）----
# 生产 App 的回调地址填 https://<正式域名>/api/auth/callback/github
# 与开发 App 分开建，凭据不共用（DESIGN 风险清单第 2 条）
GITHUB_ID=
GITHUB_SECRET=
# 允许登录的 GitHub 数字 ID，逗号分隔
ALLOWED_GITHUB_IDS=

# ---- 阿里云 OSS 图片上传（Phase 5b）----
# Bucket 公共读；RAM 策略 LaityOssUploadPolicy 只给 oss:PutObject，且限定 acs:oss:*:*:laity-archive/logs/*
# 对象键前缀在 src/lib/oss.ts 里硬编码为 logs/，换前缀要同步换 RAM 策略的 Resource
# 生产另建一把 AccessKey（不与本地 .env 复用）；本地那把曾在对话里明文出现，上线前先在 RAM 控制台轮换
# 外链域名由代码按 https://<bucket>.<region>.aliyuncs.com/<key> 拼，不读本文件里的自定义域名变量
OSS_REGION=oss-cn-beijing
OSS_BUCKET=laity-archive
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 这四个键由 docker-compose.prod.yml 的 app 服务透传进容器，缺失时 compose 在部署阶段就报错（I024 已修）
